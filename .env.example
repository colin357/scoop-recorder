# Postgres connection string. On Vercel this is set automatically when you attach a Neon / Vercel Postgres store.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# AI provider for summaries, task extraction, and "Ask AI".
# Set one of these keys. If both are set, xAI is used unless AI_PROVIDER=anthropic.
XAI_API_KEY=
XAI_MODEL=grok-4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# AI_PROVIDER=xai | anthropic (optional override)

# Recall.ai: the bot that joins Google Meet / Zoom / Teams and records.
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=

# Public URL of this app, used for webhook callbacks (e.g. https://app.example.com or an ngrok URL)
APP_URL=http://localhost:3000

# Calendar auto-record (optional). Create OAuth apps and set redirect URIs to
#   <APP_URL>/api/calendar/google/callback and <APP_URL>/api/calendar/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Any long random string; encrypts stored calendar tokens.
TOKEN_ENCRYPTION_KEY=
# Vercel sets this automatically for cron requests when defined; protects /api/cron/*
CRON_SECRET=

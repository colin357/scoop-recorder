# Postgres connection string. On Vercel this is set automatically when you attach a Neon / Vercel Postgres store.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# AI provider for summaries, task extraction, and "Ask AI".
# Set one of these keys. If both are set, xAI is used unless AI_PROVIDER=anthropic.
XAI_API_KEY=
XAI_MODEL=grok-4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# AI_PROVIDER=xai | anthropic (optional override)

# Recall.ai: the bot that joins Google Meet / Zoom / Teams and records.
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=

# Phone calls (optional): Twilio places "Call with Rocky" calls and answers merge-ins.
# Point the number's "A call comes in" webhook at <APP_URL>/api/twilio/voice/inbound (HTTP POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12395550100
# Speech-to-text for phone recordings
DEEPGRAM_API_KEY=

# Public URL of this app, used for webhook callbacks (e.g. https://app.example.com or an ngrok URL)
# Canonical public URL. In production: https://www.scooprecorder.com (note the www — the apex redirects to it).
APP_URL=http://localhost:3000

# Calendar auto-record (optional). Create OAuth apps and set redirect URIs to
#   <APP_URL>/api/calendar/google/callback and <APP_URL>/api/calendar/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Any long random string; encrypts stored calendar tokens.
TOKEN_ENCRYPTION_KEY=
# Vercel sets this automatically for cron requests when defined; protects /api/cron/*
CRON_SECRET=

# Transactional email (invites, task assignments, summaries, password resets). Without it, emails are logged, not sent.
RESEND_API_KEY=
# Sender for invites and password resets
EMAIL_FROM_AUTH="Scoop <login@scooprecorder.com>"
# Sender for summaries, task assignments and other product notifications
EMAIL_FROM_NOTIFY="Rocky at Scoop <notifications@scooprecorder.com>"
# Legacy single sender; still used for account mail when EMAIL_FROM_AUTH is unset
EMAIL_FROM="Scoop <no-reply@scooprecorder.com>"

# Operator usage dashboard at /admin: comma-separated emails allowed to view it
SUPERADMIN_EMAILS=
# Optional: USD per million tokens, to show AI cost per organization on /admin
AI_COST_PER_M_INPUT=
AI_COST_PER_M_OUTPUT=

# Billing (Stripe). With STRIPE_SECRET_KEY set, every organization must start a
# 14-day trial (card required) before recording. The product, prices and portal
# configuration are created in your Stripe account automatically on first use.
# Webhook: https://<APP_URL>/api/webhooks/stripe with events checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (optional)
# PostHog: project API key (starts with phc_) from PostHog → Project settings.
# Events go through /ingest on this domain (see next.config.ts). Set the host
# to https://eu.i.posthog.com for an EU project. Redeploy after changing.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Meta Pixel ID (defaults to Scoop's pixel)
NEXT_PUBLIC_META_PIXEL_ID=

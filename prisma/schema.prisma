generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres (Neon / Vercel Postgres / Supabase). DATABASE_URL comes from the environment.
datasource db {
  provider = "postgresql"
}

// ---------- Tenancy & auth ----------

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  // What the company does, who its clients are, current initiatives. Drives project guessing.
  businessDescription String?
  // auto | ask | off — what to do with calendar meetings that have a video link
  autoRecordPolicy    String   @default("ask")
  // Hold AI-generated tasks as drafts until an admin approves them
  reviewBeforeAssign  Boolean  @default(false)
  // Recording consent & retention
  botName             String?
  recordingNotice     Boolean  @default(true)
  retentionDays       Int?
  // Notifications
  slackWebhookUrl     String?
  teamsWebhookUrl     String?
  onboardedAt         DateTime?
  // Billing (Stripe). billingStatus: none | trialing | active | past_due | canceled | unpaid | comped
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  billingStatus        String    @default("none")
  billingPlan          String?   // standard (current per-person plan) | starter | team (legacy, grandfathered)
  billingInterval      String?   // month | year
  seats                Int       @default(1)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  overageBilledThrough String?   // "YYYY-MM" of the last calendar month whose phone overage was invoiced
  phoneAddonItemId     String?   // Stripe subscription item for the phone-calls add-on, when it's on
  phoneAddonSince      DateTime? // when the add-on was turned on (phone overage only counts calls after this)
  createdAt           DateTime @default(now())

  members             Membership[]
  projects            Project[]
  meetings            Meeting[]
  tasks               Task[]
  calendarConnections CalendarConnection[]
  calendarEvents      CalendarEvent[]
  activity            ActivityLog[]
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String
  passwordHash         String?
  passwordResetToken   String?  @unique
  passwordResetExpires DateTime?
  createdAt            DateTime @default(now())

  // Mobile (E.164) verified with Twilio: rings for "Call with Rocky", shown as caller ID,
  // and recognised when the user merges Rocky into a call
  phone                String?   @unique
  phoneVerifiedAt      DateTime?
  phonePending         String?
  sessions    Session[]
  memberships Membership[]
  onboarding  OnboardingDraft?
  support     SupportRequest[]
}

// Support requests filed from the in-app help button. Also emailed to support.
model SupportRequest {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId      String?
  orgName    String?
  email      String
  name       String
  category   String // bug | question | billing | feature | other
  subject    String
  message    String
  pageUrl    String?
  userAgent  String?
  // open | resolved
  status     String    @default("open")
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// Conversational onboarding state so a refresh does not lose progress.
model OnboardingDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  String   // JSON: {role, content, widget?}[]
  draft     String   // JSON: OnboardingDraftData
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A person on a company's team. Roles/responsibilities drive AI task assignment.
model Membership {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  name             String
  role             String   // e.g. "Account Manager", "Designer"
  responsibilities String   // free text: what tasks they typically handle
  isAdmin          Boolean  @default(false)
  inviteToken      String?  @unique
  invitedAt        DateTime?
  slackUserId      String?
  notifyByEmail    Boolean  @default(true)
  createdAt        DateTime @default(now())

  projects      ProjectMember[]
  assignedTasks Task[]
  calendars     CalendarConnection[]
  comments      TaskComment[]
  activity      ActivityLog[]

  @@unique([orgId, email])
}

// ---------- Calendars ----------

model CalendarConnection {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId     String
  member       Membership @relation(fields: [memberId], references: [id], onDelete: Cascade)
  provider     String   // google | microsoft
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  syncedAt     DateTime?
  syncError    String?
  createdAt    DateTime @default(now())

  events CalendarEvent[]

  @@unique([memberId, provider, email])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId     String
  title          String
  startAt        DateTime
  endAt          DateTime
  meetingUrl     String
  platform       String
  organizerEmail String?
  attendees      String   // JSON: {name?, email?}[]
  // undecided | record | skip
  decision       String   @default("undecided")
  meetingId      String?  @unique
  meeting        Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([connectionId, externalId])
  @@index([orgId, startAt])
}

// ---------- Projects ----------

model Project {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#6366f1")
  // Archived projects keep their meetings and tasks but are hidden from pickers and filters
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  members  ProjectMember[]
  meetings Meeting[]
  tasks    Task[]
}

model ProjectMember {
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Membership @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
}

// ---------- Meetings ----------

model Meeting {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  platform     String   // google_meet | zoom | teams | other
  meetingUrl   String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  durationSec  Int?
  // scheduled | joining | recording | processing | done | failed
  status       String   @default("scheduled")
  recallBotId  String?  @unique
  // Phone calls (platform "phone"): bridge = Rocky called both people, merge = user added Rocky
  callSid            String?  @unique
  callKind           String?
  twilioRecordingSid String?
  phoneContact       String?
  // Rocky's suggestion when a meeting fits no existing project (never auto-created)
  suggestedProjectName        String?
  suggestedProjectDescription String?
  recordingUrl String?
  // Small JPEG data URL captured from the recording, shown in lists
  thumbnail    String?
  transcript   String?  // JSON: TranscriptSegment[]
  summary      String?
  keyPoints    String?  // JSON: string[]
  decisions    String?  // JSON: string[]
  error        String?
  reviewedAt   DateTime?
  notifiedAt   DateTime?
  recordingDeletedAt DateTime?
  aiInputTokens  Int?
  aiOutputTokens Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendees     MeetingAttendee[]
  tasks         Task[]
  commitments   MeetingCommitment[]
  calendarEvent CalendarEvent?
}

// Something a person outside the team said they would do. Not a task for the
// team; listed on the meeting as "waiting on others" and optionally tracked.
model MeetingCommitment {
  id                 String   @id @default(cuid())
  meetingId          String
  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ownerName          String
  title              String
  description        String
  dueDate            DateTime?
  sourceTimestampSec Int?
  sourceQuote        String?
  taskId             String?  @unique
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  email     String?
}

// ---------- Tasks ----------

model Task {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingId     String?
  meeting       Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      Membership? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title         String
  description   String
  // todo | in_progress | blocked | done
  status        String   @default("todo")
  // low | medium | high | urgent
  priority      String   @default("medium")
  dueDate       DateTime?
  // Why the AI assigned it to this person / picked this deadline
  assignmentReason String?
  // Seconds into the recording where this task was discussed
  sourceTimestampSec Int?
  // Verbatim snippet from the transcript that produced the task
  sourceQuote   String?
  // daily | weekly | biweekly | monthly — marking it done creates the next occurrence
  recurrence    String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps      TaskStep[]
  messages   TaskMessage[]
  comments   TaskComment[]
  commitment MeetingCommitment?
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Membership? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

// Audit trail: who did what, across the org.
model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      Membership? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. task.status_changed, meeting.deleted, member.invited
  entityType String   // task | meeting | member | project | org
  entityId   String?
  summary    String   // human-readable
  meta       String?  // JSON
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model TaskStep {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  details     String?
  dueDate     DateTime?
  completedAt DateTime?
}

// "Ask AI about this task" chat history
model TaskMessage {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())
}
